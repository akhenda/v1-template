{
  "name": "@repo/web-features",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./features/*": "./src/features/*.tsx",
    "./features/types/*": "./src/features/*.ts",
    "./features/libs/*": "./src/features/*.ts",
    "./features/utils/*": "./src/features/*.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "biome format --write .",
    "lint": "biome check ./src",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@clerk/nextjs": "6.36.0",
    "@repo/auth": "workspace:*",
    "@repo/cms": "workspace:*",
    "@repo/emails": "workspace:*",
    "@repo/feature-flags": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/notifications": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/rate-limit": "workspace:*",
    "@repo/security": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/web-design-system": "workspace:*",
    "lucide-react": "0.556.0",
    "next": "16.0.10",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-i18next": "15.4.1",
    "zod": "4.1.13",
    "zustand": "5.0.3",
    "zustand-x": "6.1.0"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
