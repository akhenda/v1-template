{
  "name": "@repo/cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./content-collections": "./dist/content-collections.js",
    "./keys": "./keys.ts",
    "./next-config": "./next-config.ts",
    "./typescript-config.json": "./typescript-config.json",
    "./components/*": "./components/*.tsx"
  },
  "scripts": {
