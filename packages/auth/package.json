{
  "name": "@repo/auth",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": {
      "types": "./dist/libs/*/index.d.ts",
      "default": "./libs/*/index.ts"
    },
    "./*/components": {
      "import": "./dist/libs/*/components/index.js",
      "require": "./dist/libs/*/components/index.js",
      "types": "./dist/libs/*/components/index.d.ts",
      "default": "./libs/*/components/index.tsx"
    },
    "./components/*": {
      "types": "./dist/libs/*/components/*.d.ts",
      "default": "./libs/*/components/*.tsx"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "default": "./keys.ts"
    },
    "./types": {
      "types": "./dist/libs/shared/types.d.ts",
      "default": "./libs/shared/types.ts"
    },
    "./*/provider": {
      "types": "./dist/libs/*/provider.d.ts",
      "default": "./libs/*/provider.tsx"
    },
    "./*/middleware": {
      "types": "./dist/libs/*/middleware.d.ts",
      "default": "./libs/*/middleware.ts"
    },
    "./*/proxy": {
      "types": "./dist/libs/*/proxy.d.ts",
      "default": "./libs/*/proxy.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@clerk/chrome-extension": "2.5.13",
    "@clerk/clerk-react": "5.37.0",
    "@clerk/nextjs": "6.36.0",
    "@clerk/themes": "2.4.42",
    "@repo/types": "workspace:*",
    "@t3-oss/env-nextjs": "0.13.8",
    "convex": "1.24.1",
    "convex-helpers": "0.1.95",
    "next": "16.0.10",
    "next-themes": "0.4.6",
    "react": "19.2.1",
    "server-only": "0.0.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@clerk/types": "4.101.5",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
