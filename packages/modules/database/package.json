{
  "name": "@repo/database",
  "version": "0.0.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "analyze": "npx drizzle-kit generate",
    "build": "npx drizzle-kit generate",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:pull": "npx drizzle-kit pull",
    "db:studio": "npx drizzle-kit studio",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d",
    "format": "biome format --write .",
    "lint": "biome check .",
    "seed": "tsx dist/src/seed.js",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "@prisma/adapter-neon": "7.1.0",
    "@prisma/client": "7.1.0",
    "@prisma/client-runtime-utils": "7.1.0",
    "@repo/observability": "workspace:*",
    "@repo/types": "workspace:*",
    "@t3-oss/env-nextjs": "0.13.8",
    "dotenv": "16.4.7",
    "dotenv-expand": "12.0.1",
    "drizzle-orm": "0.41.0",
    "drizzle-zod": "0.6.1",
    "pg": "8.13.1",
    "postgres": "3.4.5",
    "remeda": "2.19.0",
    "server-only": "0.0.1",
    "ulid": "2.3.0",
    "undici": "7.16.0",
    "ws": "8.18.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "bufferutil": "4.0.9",
    "cross-env": "7.0.3",
    "drizzle-kit": "0.30.6",
    "prisma": "7.1.0",
    "tsx": "4.19.3",
    "typescript": "5.9.3"
  }
}
